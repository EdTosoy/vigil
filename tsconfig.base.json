{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@vigil/money": ["libs/money/src/index.ts"],
      "@vigil/ledger-domain": ["libs/ledger-domain/src/index.ts"],
      "@vigil/ledger-postgres": ["libs/ledger-postgres/src/index.ts"],
      "@vigil/simulator": ["libs/simulator/src/index.ts"],
      "@vigil/simulator-oracle": ["libs/simulator-oracle/src/index.ts"],
      "@vigil/ingestion-domain": ["libs/ingestion-domain/src/index.ts"],
      "@vigil/ingestion-postgres": ["libs/ingestion-postgres/src/index.ts"],
      "@vigil/processor-domain": ["libs/processor-domain/src/index.ts"],
      "@vigil/processor-postgres": ["libs/processor-postgres/src/index.ts"],
      "@vigil/bank-domain": ["libs/bank-domain/src/index.ts"],
      "@vigil/bank-postgres": ["libs/bank-postgres/src/index.ts"],
      "@vigil/reconciliation-domain": [
        "libs/reconciliation-domain/src/index.ts"
      ],
      "@vigil/reconciliation-postgres": [
        "libs/reconciliation-postgres/src/index.ts"
      ],
      "@vigil/exception-domain": ["libs/exception-domain/src/index.ts"],
      "@vigil/exception-postgres": ["libs/exception-postgres/src/index.ts"],
      "@vigil/control-domain": ["libs/control-domain/src/index.ts"],
      "@vigil/control-postgres": ["libs/control-postgres/src/index.ts"],
      "@vigil/worker-postgres": ["libs/worker-postgres/src/index.ts"],
      "@vigil/integrity-postgres": ["libs/integrity-postgres/src/index.ts"],
      "@vigil/operations-read-postgres": [
        "libs/operations-read-postgres/src/index.ts"
      ],
      "@vigil/stripe-integration": ["libs/stripe-integration/src/index.ts"],
      "@vigil/stripe-postgres": ["libs/stripe-postgres/src/index.ts"],
      "@vigil/integrations": ["apps/integrations/src/index.ts"]
    }
  }
}
